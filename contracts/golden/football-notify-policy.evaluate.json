    {
      "name": "开赛前 45 分钟触发开赛提醒",
      "from": [
        "FootballNotifyPolicyTest.kickoff within 60 minutes notifies"
      ],
      "input": {
        "status": {
          "nextMatches": [
            {
              "idEvent": "m1",
              "timestamp": "2026-09-10T18:45:00Z",
              "status": "SCHEDULED",
              "homeTeam": "Real Madrid",
              "awayTeam": "Barcelona",
              "isHome": true,
              "league": "La Liga"
            }
          ]
        },
        "now": "2026-09-10T18:00:00Z",
        "previous": {
          "kickoffNotifiedIds": [],
          "finishedNotifiedIds": []
        }
      },
      "expected": {
        "notifications": [
          {
            "title": "皇马 vs Barcelona",
            "body": "La Liga · 20:45 开球",
            "matchId": "m1"
          }
        ],
        "newState": {
          "kickoffNotifiedIds": [
            "m1"
          ],
          "finishedNotifiedIds": []
        }
      }
    },
