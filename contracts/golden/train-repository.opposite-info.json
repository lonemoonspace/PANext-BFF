      "name": "对向车取消：CANCELLED",
      "from": [
        "TrainRepositoryOppositeTest.opposite train cancelled reports CANCELLED"
      ],
      "input": {
        "calls": [
          {
            "realtime": true,
            "aimedDepartureTime": "2026-09-10T08:12:00+02:00",
            "expectedDepartureTime": "2026-09-10T08:12:00+02:00",
            "cancellation": false,
            "destinationDisplay": {
              "frontText": "Lillestrøm"
            },
            "serviceJourney": {
              "journeyPattern": {
                "line": {
                  "publicCode": "L1"
                }
              }
            }
          },
          {
            "realtime": true,
            "aimedDepartureTime": "2026-09-10T08:10:00+02:00",
            "expectedDepartureTime": "2026-09-10T08:10:00+02:00",
            "cancellation": true,
            "destinationDisplay": {
              "frontText": "Spikkestad"
            },
            "serviceJourney": {
              "journeyPattern": {
                "line": {
                  "publicCode": "L1"
