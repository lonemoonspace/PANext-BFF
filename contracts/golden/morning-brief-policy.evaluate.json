{
  "subject": "MorningBriefPolicy.evaluate",
  "kotlin": "app/src/main/java/com/personalassistant/app/domain/MorningBriefPolicy.kt",
  "cases": [
    {
      "name": "上班窗口内首次刷新无历史发送记录 → 通知",
      "from": [
        "MorningBriefPolicyTest.first refresh inside WORK window with no previous send notifies"
      ],
      "input": {
        "weather": {
          "temperature": 5.0,
          "symbolCode": "cloudy"
        },
        "train": {
          "work": {
            "legs": [
              {
                "line": "L1",
                "depTime": "2026-09-10T07:15:00+02:00",
                "cancelled": false,
                "delayKnown": true,
                "delayMin": 0
              }
            ]
          }
        },
        "traffic": {
          "durationSec": 1800
        },
        "window": "WORK",
        "today": "2026-09-10",
        "lastSentDate": null
      },
      "expected": {
        "shouldNotify": true,
        "title": "早间简报",
        "body": "5°C ☁️ 阴 · L1 07:15 正点 · 预计用时 30 分钟",
        "newLastSentDate": "2026-09-10"
      }
    },
