{
  "subject": "TimeUtils.parseIso",
  "kotlin": "app/src/main/java/com/personalassistant/app/util/TimeUtils.kt",
  "cases": [
    {
      "name": "带 +02:00 偏移直接换算",
      "from": [],
      "input": {
        "value": "2026-09-23T09:00:00+02:00"
      },
      "expected": "2026-09-23T09:00:00+02:00"
    },
    {
      "name": "Z 输入换算为 Oslo 偏移",
      "from": [],
      "input": {
        "value": "2026-09-23T07:00:00Z"
      },
      "expected": "2026-09-23T09:00:00+02:00"
    },
    {
      "name": "省略秒仍可解析",
      "from": [],
      "input": {
        "value": "2026-09-23T09:00+02:00"
      },
      "expected": "2026-09-23T09:00:00+02:00"
    },
    {
      "name": "带小数秒仍可解析",
      "from": [],
      "input": {
        "value": "2026-09-23T09:00:00.123+02:00"
      },
      "expected": "2026-09-23T09:00:00.123+02:00"
    },
    {
      "name": "不带偏移返回 null",
      "from": [],
      "input": {
        "value": "2026-09-23T09:00:00"
      },
      "expected": null
    },
    {
      "name": "纯日期返回 null",
      "from": [],
      "input": {
        "value": "2026-09-23"
      },
      "expected": null
    },
    {
      "name": "RFC 1123 格式可解析",
      "from": [],
      "input": {
        "value": "Wed, 23 Sep 2026 07:00:00 GMT"
      },
      "expected": "2026-09-23T09:00:00+02:00"
    },
    {
      "name": "空字符串返回 null",
      "from": [],
      "input": {
        "value": ""
      },
      "expected": null
    },
    {
      "name": "null 返回 null",
      "from": [],
      "input": {
        "value": null
      },
      "expected": null
    },
    {
      "name": "夏令时开始前一刻按冬令时偏移",
      "from": [],
      "input": {
        "value": "2026-03-29T00:30:00Z"
      },
      "expected": "2026-03-29T01:30:00+01:00"
    },
    {
      "name": "夏令时开始后一刻按夏令时偏移",
      "from": [],
      "input": {
        "value": "2026-03-29T01:30:00Z"
      },
      "expected": "2026-03-29T03:30:00+02:00"
    },
    {
      "name": "偏移超过 18 小时返回 null",
      "from": [],
      "input": {
        "value": "2026-09-23T09:00:00+25:00"
      },
      "expected": null
    },
    {
      "name": "RFC 1123 星期不符返回 null",
      "from": [],
      "input": {
        "value": "Mon, 23 Sep 2026 07:00:00 GMT"
      },
      "expected": null
    },
    {
      "name": "RFC 1123 日为单个数字",
      "from": [],
      "input": {
        "value": "Thu, 1 Oct 2026 07:00:00 GMT"
      },
      "expected": "2026-10-01T09:00:00+02:00"
    },
    {
      "name": "小写 z 也表示 UTC",
      "from": [],
      "input": {
        "value": "2026-09-23T07:00:00z"
      },
      "expected": "2026-09-23T09:00:00+02:00"
    },
    {
      "name": "偏移省略分钟仍可解析",
      "from": [],
      "input": {
        "value": "2026-09-23T09:00:00+02"
      },
      "expected": "2026-09-23T09:00:00+02:00"
    },
    {
      "name": "偏移分钟非法返回 null",
      "from": [],
      "input": {
        "value": "2026-09-23T09:00:00+02:99"
      },
      "expected": null
    },
    {
      "name": "RFC 1123 数字偏移",
      "from": [],
      "input": {
        "value": "Wed, 23 Sep 2026 09:00:00 +0200"
      },
      "expected": "2026-09-23T09:00:00+02:00"
    },
    {
      "name": "ISO 负偏移",
      "from": [],
      "input": {
        "value": "2026-09-23T04:00:00-03:00"
      },
      "expected": "2026-09-23T09:00:00+02:00"
    },
    {
      "name": "非法日期 2026-02-30 返回 null",
      "from": [],
      "input": {
        "value": "2026-02-30T09:00:00+02:00"
      },
      "expected": null
    },
    {
      "name": "小数秒 .5",
      "from": [],
      "input": {
        "value": "2026-09-23T09:00:00.5+02:00"
      },
      "expected": "2026-09-23T09:00:00.5+02:00"
    }
  ]
}
