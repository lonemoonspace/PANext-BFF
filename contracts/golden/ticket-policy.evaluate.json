{
  "subject": "TicketPolicy.evaluate",
  "kotlin": "app/src/main/java/com/personalassistant/app/domain/TicketPolicy.kt",
  "cases": [
    {
      "name": "进入提醒期首次发 soon 通知",
      "from": [
        "TicketPolicyTest.notifies once when entering the warning period and once on the last day"
      ],
      "input": {
        "transitPassUntil": "2026-09-17T23:59:59",
        "parkingPassUntil": "",
        "now": "2026-09-15T10:00:00+02:00",
        "previousKeys": []
      },
      "expected": {
        "notifications": [
          {
            "kind": "TRANSIT",
            "title": "乘车月票还剩 2 天",
            "body": "有效期至 9月17日 23:59，记得在 Ruter 续买，并回到设置更新截止时间。"
          }
        ],
        "newKeys": [
          "TRANSIT:2026-09-17T23:59:soon"
        ]
      }
    },
    {
      "name": "同一档不重复提醒",
      "from": [
        "TicketPolicyTest.notifies once when entering the warning period and once on the last day"
      ],
      "input": {
        "transitPassUntil": "2026-09-17T23:59:59",
        "parkingPassUntil": "",
        "now": "2026-09-16T10:00:00+02:00",
        "previousKeys": [
          "TRANSIT:2026-09-17T23:59:soon"
        ]
      },
      "expected": {
        "notifications": [],
        "newKeys": [
          "TRANSIT:2026-09-17T23:59:soon"
        ]
      }
    },
    {
      "name": "截止当天发 last 通知",
      "from": [
        "TicketPolicyTest.notifies once when entering the warning period and once on the last day"
      ],
      "input": {
        "transitPassUntil": "2026-09-17T23:59:59",
