{
  "subject": "CommuteDisruptionPolicy.evaluate",
  "kotlin": "app/src/main/java/com/personalassistant/app/domain/CommuteDisruptionPolicy.kt",
  "cases": [
    {
      "name": "窗口外不通知，指纹原样透传",
      "from": [
        "CommuteDisruptionPolicyTest.outside window never notifies even with a cancelled leg",
        "CommuteDisruptionPolicyTest.outside window leaves previous fingerprint untouched"
      ],
      "input": {
        "status": {
          "work": {
            "legs": [
              {
                "line": "L1",
                "depTime": "2026-09-09T08:00:00+02:00",
                "cancelled": true,
                "delayKnown": true,
                "delayMin": 0
              }
            ]
          }
        },
        "window": "OUTSIDE",
        "previousFingerprint": "some-fingerprint"
      },
      "expected": {
        "shouldNotify": false,
        "title": "",
        "body": "",
        "newFingerprint": "some-fingerprint"
      }
    },
    {
      "name": "没有异常段不通知",
      "from": [
        "CommuteDisruptionPolicyTest.no disrupted legs does not notify"
      ],
      "input": {
        "status": {
          "work": {
            "legs": [
