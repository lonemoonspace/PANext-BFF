                "line": "L1",
                "depTime": "2026-09-09T08:00:00+02:00",
                "cancelled": false,
                "delayKnown": true,
                "delayMin": 0
              },
              {
                "line": "L1",
                "depTime": "2026-09-09T08:00:00+02:00",
                "cancelled": false,
                "delayKnown": true,
                "delayMin": 2
